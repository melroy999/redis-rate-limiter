# Docker Compose Environment Variables.
# Copy this file to .env and customize as needed.

# Redis port mapping (to avoid conflicts with local Redis).
# Default: 6380 (maps Docker Redis 6379 -> localhost 6380).
# Set to 6379 if you want to replace your local Redis.
REDIS_PORT=6380

# For development: point your local tests to Docker Redis.
# Uncomment these if running tests locally (not in Docker).
# REDIS_HOST=localhost
# REDIS_PORT=6380
